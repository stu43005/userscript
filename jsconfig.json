{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "lib": ["es2022", "dom"],
    "types": ["tampermonkey"],
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["**/*.user.js"],
  "exclude": ["types/idb-global.d.ts"]
}
